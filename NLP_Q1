# RUN THIS SETUP FIRST
import time
from collections import Counter
import numpy as np
import pandas as pd
import spacy

from spacy import displacy
from spacy.language import Language
from spacy.tokens import Doc

nlp = spacy.load("en_core_web_sm")

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 30)
pd.set_option("display.max_rows", 100)

print("spaCy version :", spacy.__version__)
print("Model loaded :", nlp.meta["name"])


# ============================================================
# Q1. TOKENIZATION USING spaCy
# ============================================================

text = ("Dr. Sharma paid Rs. 1,250.50 for 3 books at Crossword, Mumbai on "
        "15-Aug-2024! Email her at sharma.r@gmail.com or visit "
        "https://www.example.com for details. Isn't it amazing? "
        "She didn't expect a 20% discount.")

doc = nlp(text)

# (a) Tokens
print("(a) Tokens")
for token in doc:
    print(token.i, "|", token.text)

# (b) Token attributes
data = []

for token in doc:
    data.append([
        token.text,
        token.idx,
        token.is_alpha,
        token.is_punct,
        token.like_num,
        token.like_email,
        token.like_url,
        token.is_currency,
        token.shape_
    ])

columns = [
    "token", "char_idx", "is_alpha", "is_punct",
    "like_num", "like_email", "like_url",
    "is_currency", "shape"
]

print("\n(b) Token attributes")
print(pd.DataFrame(data, columns=columns))

# (c) Counts
print("\n(c) Total tokens :", len(doc))
print(" Word tokens :", sum(t.is_alpha for t in doc))
print(" Punctuation :", sum(t.is_punct for t in doc))
print(" Numbers :", sum(t.like_num for t in doc))

# (d) Sentences
print("\n(d) Sentences")
for i, sentence in enumerate(doc.sents, 1):
    print("S" + str(i) + ":", sentence.text)

# (e) split() vs spaCy
split_words = text.split()
spacy_words = [t.text for t in doc]

print("\n(e) str.split() tokens :", len(split_words))
print(" spaCy tokens :", len(spacy_words))
print(" split() keeps these together :",
      [w for w in split_words if w not in spacy_words])

print(" Observation: spaCy separates punctuation, splits contractions "
      "(Isn't -> Is + n't) and keeps emails/URLs/'Dr.' as single tokens.")
