# RUN THIS SETUP FIRST
import time
from collections import Counter
import numpy as np
import pandas as pd
import spacy

from spacy import displacy
from spacy.language import Language
from spacy.tokens import Doc

nlp = spacy.load("en_core_web_sm")

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 30)
pd.set_option("display.max_rows", 100)

print("spaCy version :", spacy.__version__)
print("Model loaded :", nlp.meta["name"])

# ============================================================
# Q7. BAG OF WORDS & BAG OF N-GRAMS
# ============================================================

from sklearn.feature_extraction.text import CountVectorizer

corpus = [
    "The food was good and the service was good.",
    "The food was bad and the service was slow.",
    "Service was quick but the food was cold.",
    "Good food, good service, good price."
]


def tokens(text):
    return [t.text.lower() for t in nlp(text) if t.is_alpha]


# (a) Manual BoW
tokenized = [tokens(text) for text in corpus]

vocab = sorted(set(
    word
    for doc_words in tokenized
    for word in doc_words
))

manual = []

for doc_words in tokenized:
    manual.append([
        doc_words.count(word)
        for word in vocab
    ])

manual_df = pd.DataFrame(
    manual,
    columns=vocab,
    index=["D1", "D2", "D3", "D4"]
)

print("\n(a) Manual Bag of Words")
print(manual_df)

# (b) CountVectorizer
cv = CountVectorizer()
X = cv.fit_transform(corpus)

sklearn_df = pd.DataFrame(
    X.toarray(),
    columns=cv.get_feature_names_out(),
    index=manual_df.index
)

print("\n(b) CountVectorizer BoW")
print(sklearn_df)

print(" Manual == sklearn ? ", manual_df.equals(sklearn_df))
print(" Matrix shape", X.shape,
      ", sparsity =",
      round(100 * (1 - X.nnz / np.prod(X.shape)), 1),
      "% zeros")

# (c) Binary BoW
binary = CountVectorizer(binary=True)

print("\n(c) Binary BoW")
print(pd.DataFrame(
    binary.fit_transform(corpus).toarray(),
    columns=binary.get_feature_names_out(),
    index=manual_df.index
))

# (d) N-grams
for n in [(1, 1), (2, 2), (1, 2), (1, 3)]:
    vectorizer = CountVectorizer(ngram_range=n)
    vectorizer.fit(corpus)
    print("\n(d) ngram_range =", n,
          "-> vocabulary size",
          len(vectorizer.vocabulary_))

bigram = CountVectorizer(ngram_range=(2, 2))

print(" Bigram matrix")
print(pd.DataFrame(
    bigram.fit_transform(corpus).toarray(),
    columns=bigram.get_feature_names_out(),
    index=manual_df.index
))

# (e) Word order
pair = [
    "The food was good, not bad.",
    "The food was bad, not good."
]

uni = CountVectorizer().fit(pair)
uni_matrix = uni.transform(pair).toarray()

bi = CountVectorizer(ngram_range=(1, 2)).fit(pair)
bi_matrix = bi.transform(pair).toarray()

print("\n(e) Unigram vectors identical? ",
      np.array_equal(uni_matrix[0], uni_matrix[1]))

print(" Uni+bigram vectors identical?",
      np.array_equal(bi_matrix[0], bi_matrix[1]))

print(" Bag of Words ignores word order, so opposite sentences look "
      "the same. Bigrams like 'not bad' vs 'not good' capture the difference.")

# (f) Unseen words
new = ["The pizza was good but the delivery was late."]

vector = cv.transform(new).toarray()[0]

known = {
    word: int(count)
    for word, count in zip(cv.get_feature_names_out(), vector)
    if count > 0
}

unknown = [
    word for word in tokens(new[0])
    if word not in cv.vocabulary_
]

print("\n(f) Counted words :", known)
print(" Ignored (OOV) :", unknown)
