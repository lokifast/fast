import tensorflow as tf 
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, SimpleRNN , Dense 
from tensorflow.keras.preprocessing.text import Tokenizer 
import numpy as np 

np.random.seed(42)
tf.random.set_seed(42)

sentences = [
    "machine learning",
    "deep learning",
    "data science",
    "artificial intelligence",
    "computer vision",
    "natural language",
    "neural network",
    "big data",
    "image processing",
    "data mining"]

tokenizer = Tokenizer()
tokenizer.fit_on_texts(sentences)

x=[]
y=[]

for sentence in sentences:
    words = sentence.split()
    x.append(tokenizer.word_index[words[0]])
    y.append(tokenizer.word_index[words[1]])
    
x=np.array(x).reshape(-1,1)
y=np.array(y)

model = Sequential([
    Embedding(input_dim=len(tokenizer.word_index)+1,
              output_dim=8,
              input_length=1),
    SimpleRNN(16),
    Dense(len(tokenizer.word_index)+1, activation="softmax")
    ])

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"])

model.fit(
    x, 
    y,
    epochs=1000,
    verbose=0)

word = input("Enter first word:").lower()


if word not in tokenizer.word_index:
    print("Word is not in Training dataset ")
else:
    test = np.array([tokenizer.word_index[word]]).reshape(-1,1)
    prediction= model.predict(test, verbose=0)
    predicted_index = np.argmax(prediction)
    
    for key , value in tokenizer.word_index.items():
        if value == predicted_index:
            print("\nInput:", word)
            print("\nPredicted Word:",key)
            break
    
