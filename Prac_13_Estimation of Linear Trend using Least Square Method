# RA PRACTICAL 13: Estimation of Linear Trend using Least Square Method

data("AirPassengers")
AirPassengers
start(AirPassengers)
end(AirPassengers)
plot(AirPassengers)

# Convert monthly passengers into annual totals
annual_passengers = aggregate(AirPassengers, nfrequency = 1, FUN = sum)
annual_passengers

# Create a data frame with year and passengers
df = data.frame(year=time(annual_passengers),
                Passengers=as.numeric(annual_passengers))
df

# Fit a linear trend using least squares
model = lm(Passengers ~ year, data = df)
summary(model)

# Calculate trend values
df$trend = fitted(model)
df

# Plot actual values and trend line
plot(df$year, df$Passengers, type="o")
abline(model)

# Predict passengers for 1961
new = data.frame(year=1961)
predict(model, newdata=new)

# Conclusion:
# The annual passenger data shows an increasing linear trend over time.
# The least-squares regression model estimates the trend and can be
# used to predict the number of passengers for future years.
