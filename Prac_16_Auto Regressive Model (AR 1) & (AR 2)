# RA PRACTICAL 16: Auto Regressive Model (AR 1) & (AR 2)

data("AirPassengers")
plot(AirPassengers)
# Difference the time series
diff_passengers = diff(AirPassengers)

# Plot differenced series
plot(diff_passengers)

# AR(1) Model
ar1_model = arima(diff_passengers, order=c(1,0,0))
ar1_model

# AR(2) Model
ar2_model = arima(diff_passengers, order=c(2,0,0))
ar2_model

# Compare models using AIC
AIC(ar1_model, ar2_model)

# Forecast next 12 periods using AR(1)
forecast_ar1 = predict(ar1_model, n.ahead=12)
forecast_ar1$pred

# Forecast next 12 periods using AR(2)
forecast_ar2 = predict(ar2_model, n.ahead=12)
forecast_ar2$pred

