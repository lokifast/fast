# RA PRACTICAL 6: Residual Analysis & Detection of Outliers in MLR

# [ Medical Insurance Cost Dataset [From Kaggle] ]

head(insurance)
tail(insurance)
str(insurance)
class(insurance)

model = lm(charges ~ age+ bmi+ children , data = insurance)
coef(model)
summary(model)
new = data.frame(age=20, bmi=40, children=2)
predict(model, newdata = new)

insurance$predicted = predict(model)
insurance$predicted

insurance$resid = residuals(model)
insurance$resid

head(insurance[, c("charges", "predicted","resid")])

insurance$stdr = rstandard(model)
insurance$stdr

head(insurance[, c("charges", "predicted","resid", "stdr")])

outliers = which(abs(insurance$stdr)>2)
outliers

insurance[outliers , c("age", "bmi","children","stdr")]

plot(model)  #Residuals vs Fitted, Q-Q, Scale-Location, Residuals vs Leverage


# 1. Residuals vs Fitted → Checks linearity and constant variance; random scatter around 0 means the model is suitable.
# 2. Normal Q-Q → Checks normality of residuals; points close to the straight line mean residuals are approximately normal.
# 3. Scale-Location → Checks constant variance; evenly scattered points indicate constant variance (no heteroscedasticity).
# 4. Residuals vs Leverage → Detects influential observations; points with high leverage/Cook’s distance may strongly affect the model.
