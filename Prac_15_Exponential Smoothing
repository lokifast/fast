# RA PRACTICAL 15: Exponential Smoothing

data("AirPassengers")
start(AirPassengers)
end(AirPassengers)
plot(AirPassengers)
library(forecast)

ses_model = ses(AirPassengers)
ses_model
ses_model$model

fitted_value = fitted(ses_model)
head(fitted_value)

plot(AirPassengers)
lines(fitted_value, lty=2)

# The plot shows the actual passenger values along with the fitted values from Simple Exponential Smoothing. 
# The fitted line smooths the fluctuations in the original data.

forecast_6 = forecast(ses_model, h=6)
forecast_6
plot(forecast_6)

# The plot shows the forecast for the next 6 periods.
# The forecast remains around the recent level, while the shaded area shows the uncertainty of the future forecasts.
