# RA PRACTICAL 2: Simple Linear Regression & Model Estimation
[ Medical Insurance Cost Dataset [From Kaggle] ]

head(insurance)
tail(insurance)
str(insurance)
class(insurance)
table(insurance$smoker)

plot(insurance$age, insurance$bmi, main="Scatter Plot", xlab="Age", ylab="bmi", col="orange", pch=19)

model = lm(bmi ~ age , data = insurance)
coef(model)
summary(model)
abline(model, col="red", lwd=2)

predict(model , newdata = data.frame(age=c(20,40,60)))

