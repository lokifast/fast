# RA PRACTICAL 4: Significance Testing & Confidence Interval in SLR
# [ Medical Insurance Cost Dataset [From Kaggle] ]

head(insurance)
tail(insurance)
str(insurance)
class(insurance)
table(insurance$smoker)


plot(insurance$age, insurance$bmi, main="Scatter Plot", xlab="Age", ylab="bmi", col="orange", pch=19)

model = lm(bmi ~ age , data = insurance)
coef(model)
summary(model)
abline(model, col="red", lwd=2)

predict(model , newdata = data.frame(age=c(20,40,60)))


# H0: B1 = 0
# H1: B1 != 0

# in summary(model) you will get P value
# If p value < 0.05 reject H0
# If p value >= 0.05 fail to reject H0

confint(model, level=0.95)
